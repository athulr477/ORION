# Orion — Database Configuration
# Copy this file to .env and fill in your values.

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://orion:orion_secret@localhost:5432/orion_db

# Sync URL for Alembic migrations (uses psycopg2 driver)
DATABASE_URL_SYNC=postgresql://orion:orion_secret@localhost:5432/orion_db

# Webhook signature secrets (HMAC-SHA256)
JIRA_WEBHOOK_SECRET=your-jira-webhook-secret-here
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# Phase 9 — GitHub App Integration
# Create a GitHub App at github.com/settings/apps and install it on your repo.
# Download the private key .pem and fill these in.
GITHUB_APP_ID=0
GITHUB_APP_INSTALLATION_ID=0
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem

# Phase 7 — Ollama LLM for evidence verbalization
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
