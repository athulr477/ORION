# Orion — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# --- Database ---
# Async URL for the application (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://orion:your_password@localhost:5432/orion_db

# Sync URL for Alembic migrations (psycopg2 driver)
DATABASE_URL_SYNC=postgresql://orion:your_password@localhost:5432/orion_db

# --- Authentication ---
# JWT signing key — REQUIRED for the server to start.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# --- Webhook Signature Secrets (HMAC-SHA256) ---
# Set these to random strings and configure matching secrets in GitHub/Jira.
JIRA_WEBHOOK_SECRET=your-jira-webhook-secret-here
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# --- GitHub App Integration ---
# Create a GitHub App at github.com/settings/apps and install it on your repo.
# Download the private key .pem file and set the path below.
GITHUB_APP_ID=0
GITHUB_APP_INSTALLATION_ID=0
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem

# --- Jira Cloud Integration ---
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY

# --- LLM Verbalization (optional) ---
# Falls back to a deterministic template if Ollama is not running.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Error Tracking (optional) ---
# Get a free DSN at https://sentry.io — leave blank to disable.
SENTRY_DSN=
